# Notes-generation LLM (NOT the live call - that's Vani's own model)
NOTES_LLM_PROVIDER=gemini          # "gemini" or "featherless"
GEMINI_API_KEY=
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=featherless/qwen2.5-7b-instruct
LLM_MAX_RETRIES=3
LLM_RETRY_BACKOFF_SECONDS=1.5

# Twilio SMS (revision notes only - Vani handles the voice call itself)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Storage
DB_PATH=data.json

# Webhook signature verification - keep false for local/offline testing.
# Confirmed from Vani's own docs (Webhooks & Events page): deliveries are
# signed with HMAC-SHA256 (hex digest, over the RAW body) in the
# X-Webhook-Signature header. Get VANI_WEBHOOK_SECRET from Vani's dashboard
# under Settings -> Webhooks when you add the webhook subscription there.
# Set WEBHOOK_VERIFY_SIGNATURE=true before the real demo.
WEBHOOK_VERIFY_SIGNATURE=false
VANI_WEBHOOK_SECRET=
VANI_SIGNATURE_HEADER=X-Webhook-Signature

# Server
PORT=5000

